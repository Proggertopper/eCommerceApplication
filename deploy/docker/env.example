# PostgreSQL (product-service)
POSTGRES_USER=ecom_user
POSTGRES_PASSWORD=change_me_postgres

# MySQL (order-service)
MYSQL_ROOT_PASSWORD=change_me_mysql
MYSQL_DATABASE=orderservice

# Service database settings
PRODUCT_DB_URL=jdbc:postgresql://postgres:5432/ecomdb
PRODUCT_DB_USER=ecom_user
PRODUCT_DB_PASSWORD=change_me_postgres
DB_USER=root
DB_PASSWORD=change_me_mysql

# Keycloak bootstrap account and user-service admin API access
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak
KEYCLOAK_SERVICE_USERNAME=admin
KEYCLOAK_SERVICE_PASSWORD=change_me_keycloak

# `oauth2-pkce` client UUID from additional/keycloak/keycloak-backups/realm-export-ecom-app.json
KEYCLOAK_CLIENT_UID=c86d151c-8725-49cb-aaed-0c38776ccdbe

# Local development only. Use Flyway or Liquibase migrations in production.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
